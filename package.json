{
  "name": "@wesleydevrodio/eslint-config",
  "version": "2.0.6",
  "description": "Configuração ESLint e Prettier opinativa e completa, focada em projetos TypeScript (Next.js e APIs RESTful)",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./next": "./next.js",
    "./api": "./api.js",
    "./prettier": "./prettier.config.js",
    "./prettier-api": "./prettier-api.config.js"
  },
  "files": [
    "index.js",
    "next.js",
    "api.js",
    "prettier.config.js",
    "prettier-api.config.js",
    "README.md"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "nextjs",
    "api",
    "restful",
    "typescript",
    "ts-eslint",
    "formatting",
    "dx"
  ],
  "author": "Wesley Rodio",
  "license": "MIT",
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "browserslist@<=4.28.6": ">=4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wesleyrodio/eslint-config.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
